public class Veiculo {

    String placa;
    String modelo;
    String tipo; 
    int horaEntrada;
    int horaSaida;
    boolean estaEstacionado;
    boolean clienteFidelizado;

    public Veiculo(String placa, String modelo, String tipo, boolean clienteFidelizado) {
        this.placa = placa;
        this.modelo = modelo;
        this.tipo = tipo;
        this.clienteFidelizado = clienteFidelizado;
        this.estaEstacionado = false;
    }

    public void entrar(int horaEntrada) {
        this.horaEntrada = horaEntrada;
        this.estaEstacionado = true;

        System.out.println("Veiculo " + placa + " entrou no estacionamento às " + horaEntrada + "h.");
    }

    public double sair(int horaSaida) {

        if (!estaEstacionado) {
            System.out.println("Erro: Este veiculo nao esta no patio!");
            return 0.0;
        }

        if (horaSaida < horaEntrada) {
            System.out.println("Erro: Hora de saida invalida!");
            return 0.0;
        }

        this.horaSaida = horaSaida;
        int horas = horaSaida - horaEntrada;

        double valorHora;

        if (tipo.equalsIgnoreCase("carro")) {
            valorHora = 10.0;
        } else {
            valorHora = 5.0;
        }

        double total = horas * valorHora;

        if (clienteFidelizado) {
            total = total * 0.9; 
        }

        estaEstacionado = false;

        System.out.println("------ RECIBO ------");
        System.out.println("Placa: " + placa);
        System.out.println("Modelo: " + modelo);
        System.out.println("Tipo: " + tipo);
        System.out.println("Horas: " + horas);
        System.out.println("Valor a pagar: R$ " + total);
        System.out.println("--------------------");

        return total;
    }

    public void mostrarDados() {
        System.out.println("Placa: " + placa);
        System.out.println("Modelo: " + modelo);
        System.out.println("Tipo: " + tipo);
        System.out.println("Cliente Fidelizado: " + clienteFidelizado);
        System.out.println("Estacionado: " + estaEstacionado);
        System.out.println();
    }
}
